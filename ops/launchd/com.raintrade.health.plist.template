<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by ops/install-recorder.sh. Health report for yesterday + today (UTC), every 6 hours
     (launchd uses local time; 6-hourly guarantees one run after the UTC day's last resolutions). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.raintrade.health</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>packages/pm-harness-store/src/cli.ts</string>
    <string>health</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>1</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>20</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>__REPO__/data/health.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/health.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
