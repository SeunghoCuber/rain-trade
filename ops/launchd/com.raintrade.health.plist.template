<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by ops/install-recorder.sh. Health report for yesterday + today (UTC), hourly at :20,
     so settled markets are checked (and counted by the dashboard) within about an hour. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.raintrade.health</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>packages/pm-harness-store/src/cli.ts</string>
    <string>health</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>20</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__REPO__/data/health.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/health.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
