# Rendered by ops/install-systemd.sh (__USER__, __REPO__, __NODE__ are substituted).
[Unit]
Description=RainTrade live paper trader (no real orders)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__
ExecStart=__NODE__ apps/harness-live/src/main.ts config/default.yaml
# the recorder flushes and exits 0 on SIGTERM; any exit is restarted
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=append:__REPO__/data/live.log
StandardError=append:__REPO__/data/live.log
# the recorder uses ~55 MB; cap it so a leak cannot take the box down
MemoryMax=512M
Nice=0

[Install]
WantedBy=multi-user.target
